{
  "name": "semaforo-digital-mass",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --host localhost --proxy-config proxy.conf.json",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "vitest run",
    "test:browser": "vitest run --mode browser",
    "test:e2e": "playwright test"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "20.3.32",
    "@angular/compiler": "20.3.32",
    "@angular/core": "20.3.32",
    "@angular/forms": "20.3.32",
    "@angular/platform-browser": "20.3.32",
    "@angular/router": "20.3.32",
    "@angular/service-worker": "20.3.32",
    "@zxing/browser": "0.2.1",
    "bootstrap": "^5.3.8",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "overrides": {
    "@angular/build": {
      "vitest": "$vitest"
    }
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.8.0",
    "@analogjs/vitest-angular": "2.8.0",
    "@angular/build": "20.3.39",
    "@angular/cli": "20.3.39",
    "@angular/compiler-cli": "20.3.32",
    "@playwright/test": "1.58.2",
    "@types/node": "24.19.1",
    "@vitest/browser-playwright": "5.0.3",
    "jsdom": "30.1.2",
    "typescript": "~5.9.2",
    "vite": "7.3.6",
    "vitest": "5.0.3"
  }
}
